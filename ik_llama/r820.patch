+static inline __m128 ggml_fa_hsum8x4(__m256 a0, __m256 a1, __m256 a2, __m256 a3) {
+    const __m256 t01 = _mm256_hadd_ps(a0, a1), t23 = _mm256_hadd_ps(a2, a3);
