+        return (const ggml_fp16_t *)(i < a->ne[2] ? (const char *) a->data + i*a->nb[2]
+                                                  : (const char *) b->data + (i - a->ne[2])*b->nb[2]);
+    }
+    return (const ggml_fp16_t *)((const char *) t->data + i*t->nb[1]);
+}
