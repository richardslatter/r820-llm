+    fprintf(stderr, "%-28s %8s %10s %10s %10s %10s\n", "op", "n/graph", "wall ms", "slowest", "average", "barrier");
+    for (;;) {
+        int best = -1;
+        for (int k = 0; k < GGML_PROF_KEYS; ++k) if (g_prof_cnt[k] && (best < 0 || g_prof_wall[k] > g_prof_wall[best])) best = k;
+        if (best < 0) break;
