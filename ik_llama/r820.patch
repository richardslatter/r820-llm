+    fprintf(stderr, "\n%-28s %8s %10s %10s %10s %10s\n", "matmul weight", "n/graph", "wall ms", "slowest", "average", "GB/s");
+    for (;;) {
+        int best = -1;
+        for (int k = 0; k < g_prof_nn; ++k) if (g_prof_ncnt[k] && (best < 0 || g_prof_nwall[k] > g_prof_nwall[best])) best = k;
