+                g_prof_nwall[best]/g, g_prof_nmax[best]/g, g_prof_nsum[best]/g,
+                g_prof_nbytes[best]/(g_prof_nwall[best]/tsc_per_us*1e3));
+        g_prof_ncnt[best] = 0;
+    }
+}
